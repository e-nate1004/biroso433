{
  "name": "비로소 레터",
  "short_name": "비로소 레터",
  "id": "/staff/",
  "start_url": "/staff/",
  "scope": "/staff/",
  "display": "standalone",
  "background_color": "#ecebe1",
  "theme_color": "#5a6930",
  "lang": "ko",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/staff/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["text/vcard", "text/x-vcard", "text/directory", ".vcf", "text/plain"] }
      ]
    }
  }
}
